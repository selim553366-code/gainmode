{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.13.0",
      "corepack": true,
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "unfolded-superior-webpages.replit.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6808943267"
      }
    }
  }
}
