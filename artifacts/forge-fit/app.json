{
  "expo": {
    "name": "Forge Fit",
    "slug": "forge-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coach-app-icon-final.png",
    "scheme": "forge-fit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/coach-app-icon-final.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D0C"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.app.fitaicoach"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "Forge Fit uses the camera to analyze your movement."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}