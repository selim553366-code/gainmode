{
  "expo": {
    "extra": {
      "apiBaseUrl": "https://unfolded-superior-webpages.replit.app",
      "eas": {
        "projectId": "970ce633-cb99-43da-992f-9217abf8ef05"
      },
      "router": {
        "origin": "https://replit.com/"
      }
    },
    "name": "GainMode",
    "slug": "forge-fit",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/coach-app-icon-final.png",
    "scheme": "forge-fit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.forgefit2.app",
      "appleTeamId": "DKA5B5CH29",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.forgefit2.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.forgefit2.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/coach-app-icon-final.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7FAFC"
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n# MediaPipe (live form analysis) looks these classes up by name from native code; keep them in release builds.\n-keep class com.google.mediapipe.** { *; }\n-dontwarn com.google.mediapipe.**\n-keep class com.google.protobuf.** { *; }\n-dontwarn com.google.protobuf.**\n-keepclasseswithmembernames class * { native <methods>; }\n# MediaPipe logs through Flogger, which finds its caller by class name on the stack; obfuscating it crashes Graph init with \"no caller found on the stack\".\n-keep class com.google.common.flogger.** { *; }\n-dontwarn com.google.common.flogger.**\n-keep class com.google.android.odml.** { *; }\n-dontwarn com.google.android.odml.**"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GainMode to use your location to show the current weather in the coach chat background.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GainMode to use your camera for meal, barcode, and movement analysis.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GainMode to access a meal photo you choose for nutrition analysis."
        }
      ],
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "GainMode uses the camera to analyze your movement."
        }
      ],
      "./plugins/withMediaPipePin",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Calories",
              "label": "GainMode · Kalori",
              "description": "Kalan kalori ve makrolar",
              "previewImage": "./assets/images/widgets/v2/preview-calories.jpg",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StartWorkout",
              "label": "GainMode · Bugünün antrenmanı",
              "description": "Günün antrenmanı ve ilerlemen, tek dokunuşla başla",
              "previewImage": "./assets/images/widgets/v2/preview-workout.jpg",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Streak",
              "label": "GainMode · Seri",
              "description": "Kaç gündür devam ettiğin ve ateşinin seviyesi",
              "previewImage": "./assets/images/widgets/v2/preview-streak.jpg",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeeklyConsistency",
              "label": "GainMode · Bu hafta",
              "description": "Haftanın antrenman ve dinlenme günleri",
              "previewImage": "./assets/images/widgets/v2/preview-week.jpg",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextGoal",
              "label": "GainMode · Sıradaki rozet",
              "description": "Kazanmaya en yakın rozetin ve kalan miktar",
              "previewImage": "./assets/images/widgets/v2/preview-badge.jpg",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "320dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Motivation",
              "label": "GainMode · FitBud",
              "description": "FitBud'dan her gün yeni bir motivasyon sözü",
              "previewImage": "./assets/images/widgets/v2/preview-fitbud.jpg",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ],
          "fonts": [
            "./assets/fonts/Inter_800ExtraBold.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
