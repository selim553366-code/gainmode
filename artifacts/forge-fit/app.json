{
  "expo": {
    "extra": {
      "eas": {
        "projectId": "970ce633-cb99-43da-992f-9217abf8ef05"
      },
      "router": {
        "origin": "https://replit.com/"
      }
    },
    "name": "Forge Fit",
    "slug": "forge-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coach-app-icon-final.png",
    "scheme": "forge-fit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/coach-app-icon-final.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D0C"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.forgefit2.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Forge Fit to use your camera for meal, barcode, and movement analysis.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Forge Fit to access a meal photo you choose for nutrition analysis."
        }
      ],
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "Forge Fit uses the camera to analyze your movement."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
