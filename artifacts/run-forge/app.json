{
  "expo": {
    "name": "RunForge",
    "slug": "run-forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/runforge-icon.png",
    "scheme": "run-forge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/runforge-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RunForge to use your camera for Record Mode."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RunForge to use your location while you run."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
