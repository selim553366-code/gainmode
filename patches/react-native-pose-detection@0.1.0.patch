+    private fun rotateLandmarksToDisplay(rotationDegrees: Int) {
+        val normalized = ((rotationDegrees % 360) + 360) % 360
+        if (normalized == 0) return
+        for (index in 0 until Skeleton.LANDMARK_COUNT) {
+            val base = index * Skeleton.LANDMARK_STRIDE
+            val x = landmarkBuffer[base + Skeleton.OFFSET_X]
+            val y = landmarkBuffer[base + Skeleton.OFFSET_Y]
+            when (normalized) {
+                90 -> {
+                    landmarkBuffer[base + Skeleton.OFFSET_X] = 1f - y
+                    landmarkBuffer[base + Skeleton.OFFSET_Y] = x
+                }
+                180 -> {
+                    landmarkBuffer[base + Skeleton.OFFSET_X] = 1f - x
+                    landmarkBuffer[base + Skeleton.OFFSET_Y] = 1f - y
+                }
+                270 -> {
+                    landmarkBuffer[base + Skeleton.OFFSET_X] = y
+                    landmarkBuffer[base + Skeleton.OFFSET_Y] = 1f - x
+                }
+            }
+        }
+    }
